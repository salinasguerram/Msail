# En producción: una clave larga y aleatoria. Vacía, en local se usa una de desarrollo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Versión web de la app (Expo usa el puerto 8081 en local)
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Adónde lleva "Ver el sitio" desde el panel
FRONTEND_URL=http://localhost:8081
# Email del equipo que recibe el aviso de cada solicitud de amarre (vacío: solo se ven en el panel)
MARINA_REQUESTS_EMAIL=
# Copia de cada pedido de presupuesto a profesionales (vacío: usa el de amarres)
QUOTE_REQUESTS_EMAIL=

# Supabase > Project Settings > Database > Connection string (URI)
# Si se deja vacío, se usa SQLite local.
DATABASE_URL=

# Login social (separados por coma)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.exissailing.msailleague

# Email. Sin clave, los emails NO se envían: se muestran en la consola donde corre Django.
# Se usa el proveedor cuya clave esté cargada (o el que diga EMAIL_PROVIDER: resend, sendgrid, brevo o smtp).
# Para probar que anda: python manage.py send_test_email tu@email.com
#
# Opción recomendada, Resend (resend.com · 3.000 emails/mes gratis):
#   1. Crear la cuenta con un email de la empresa y agregar el dominio msailleague.com en "Domains".
#   2. Cargar en el DNS del dominio los registros que muestra Resend (SPF y DKIM) y esperar el "Verified".
#   3. Crear una API key con permiso "Sending access" y pegarla acá.
RESEND_API_KEY=
# Remitente: tiene que ser del dominio verificado.
DEFAULT_FROM_EMAIL=MSAIL LEAGUE <no-reply@msailleague.com>
#
# Otras opciones (solo una):
# SENDGRID_API_KEY=
# BREVO_SMTP_LOGIN=
# BREVO_SMTP_KEY=
# SMTP propio, ej. Gmail solo para pruebas (verificación en 2 pasos + contraseña de aplicación en
# https://myaccount.google.com/apppasswords):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación
# DEFAULT_FROM_EMAIL=MSAIL LEAGUE <tu-cuenta@gmail.com>

# Fotos en Supabase Storage (Project Settings > Storage > S3 Connection). Vacío = carpeta media/ local.
SUPABASE_STORAGE_BUCKET=
SUPABASE_PROJECT_URL=https://<proyecto>.supabase.co
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# MSAIL Premium: cobro con Stripe (Dashboard > Developers > API keys / Webhooks).
# Webhook: https://<api>/api/premium/stripe/webhook/ con los eventos checkout.session.completed y customer.subscription.*
# Vacías: los planes se ven en la app pero no se pueden pagar (las membresías se dan a mano desde el panel).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email de contacto de la política de privacidad y los términos (el que atiende pedidos de datos personales).
LEGAL_CONTACT_EMAIL=
