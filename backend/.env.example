DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Versión web de la app (Expo usa el puerto 8081 en local)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Supabase > Project Settings > Database > Connection string (URI)
# Si se deja vacío, se usa SQLite local.
DATABASE_URL=

# Login social (separados por coma)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.exissailing.msailleague

# Email (Twilio SendGrid). Sin estas variables, los emails se muestran en la consola.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=MSAIL LEAGUE <no-reply@msailleague.com>

# Fotos en Supabase Storage (Project Settings > Storage > S3 Connection). Vacío = carpeta media/ local.
SUPABASE_STORAGE_BUCKET=
SUPABASE_PROJECT_URL=https://<proyecto>.supabase.co
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
