DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Versión web de la app (Expo usa el puerto 8081 en local)
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Adónde lleva "Ver el sitio" desde el panel
FRONTEND_URL=http://localhost:8081

# Supabase > Project Settings > Database > Connection string (URI)
# Si se deja vacío, se usa SQLite local.
DATABASE_URL=

# Login social (separados por coma)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.exissailing.msailleague

# Email. Sin clave, los emails NO se envían: se muestran en la consola donde corre Django.
# Opción 1, producción (Twilio SendGrid, con el dominio verificado):
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=MSAIL LEAGUE <no-reply@msailleague.com>
# Opción 2, para probar con una cuenta de Gmail (requiere verificación en 2 pasos y una
# "contraseña de aplicación" creada en https://myaccount.google.com/apppasswords):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación-de-16-letras
# DEFAULT_FROM_EMAIL=MSAIL LEAGUE <tu-cuenta@gmail.com>

# Fotos en Supabase Storage (Project Settings > Storage > S3 Connection). Vacío = carpeta media/ local.
SUPABASE_STORAGE_BUCKET=
SUPABASE_PROJECT_URL=https://<proyecto>.supabase.co
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
