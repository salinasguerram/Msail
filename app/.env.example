# URL del backend Django.
# - Navegador o simulador iOS: http://localhost:8000/api
# - Emulador Android: http://10.0.2.2:8000/api
# - Celular real: http://<IP-de-tu-PC>:8000/api (y correr Django con 0.0.0.0:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Imagen satelital al acercarse al planeta (mosaicos XYZ con {z}/{x}/{y}).
# Vacío: Esri World Imagery sin cuenta (para desarrollo). Para publicar, con la API key de ArcGIS Location Platform:
# EXPO_PUBLIC_SATELLITE_TILES_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=TU_KEY
# EXPO_PUBLIC_SATELLITE_ATTRIBUTION=Imágenes © Esri, Maxar, Earthstar Geographics
# Para desactivarla: EXPO_PUBLIC_SATELLITE_TILES_URL=off
