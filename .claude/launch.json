{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8000"],
      "port": 8000
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "web", "--", "--port", "8081"],
      "port": 8081
    }
  ]
}
